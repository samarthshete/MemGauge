# MemGauge example environment. Copy to .env (`cp .env.example .env`).
# ALL values below are LOCAL-ONLY, NON-SECRET defaults for the docker-compose
# stack. They are safe to commit in THIS example file. Never commit a real .env
# (it is gitignored). The default `mock` backend needs no API keys at all.
# Host-side `make seed`/`make eval` target the mapped ports (15432/17687/16379);
# the in-container DSNs below use service names (postgres/neo4j/redis).
MEMGAUGE_BACKEND=mock
MEMGAUGE_API_TOKEN=dev-token
POSTGRES_DSN=postgresql+asyncpg://memgauge:memgauge@postgres:5432/memgauge
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memgauge-dev
REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CORS_ALLOW_ORIGINS=
RATE_LIMIT_PER_MIN=60
# Postgres async connection pool (SQLAlchemy). Defaults reproduce the documented
# load-test "before" bottleneck (~15 max conns). Raise for the "after" run, e.g.
# DB_POOL_SIZE=20 DB_MAX_OVERFLOW=40. Stay under Postgres max_connections (100).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

